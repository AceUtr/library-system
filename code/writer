from docx import Document
from docx.shared import Pt, Cm
from docx.oxml import OxmlElement
from docx.oxml.ns import qn

def add_textbox_to_docx(doc_path, content, font_name='Consolas', font_size=10.5, fill_color='#F5F5F5'):
    """
    在指定 Word 文档末端添加文本框，并填充指定内容
    :param doc_path: 文档路径
    :param content: 要填充的文本内容
    :param font_name: 文本字体
    :param font_size: 字号
    :param fill_color: 文本框填充颜色(十六进制)
    """

    doc = Document(doc_path)

    # 添加文本框
    paragraph = doc.add_paragraph()
    run = paragraph.add_run(content)

    # 设置字体
    run.font.name = font_name
    run._element.rPr.rFonts.set(qn('w:eastAsia'), font_name)
    run.font.size = Pt(font_size)

    # 添加浅灰背景
    # 在 Word 中可以通过设置段落底纹实现文本框背景
    p = run.paragraph
    p_format = p.paragraph_format

    # 设置段落底纹颜色 (Word接受十六进制RGB不带#)
    shading_elm = OxmlElement('w:shd')
    shading_elm.set(qn('w:val'), 'clear')
    shading_elm.set(qn('w:color'), 'auto')
    shading_elm.set(qn('w:fill'), fill_color.replace('#',''))
    p._p.get_or_add_pPr().append(shading_elm)

    doc.save(doc_path)


